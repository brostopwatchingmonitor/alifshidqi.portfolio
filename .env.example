# Supabase — Session Pooler (port 5432)
# Ambil dari Supabase Dashboard > Project Settings > Database > Connection string > Session pooler.
# Format: postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=""

# Fallback opsional — dipakai hanya jika DATABASE_URL kosong.
# DB_HOST=
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=
# DB_PASSWORD=
# DB_SSLMODE=require
