{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    { "src": "index.php", "use": "vercel-php@0.9.0" },
    { "src": "api/*.php", "use": "vercel-php@0.9.0" },
    { "src": "styles.css", "use": "@vercel/static" },
    { "src": "main.js", "use": "@vercel/static" },
    { "src": "performance-graph.html", "use": "@vercel/static" },
    { "src": "img/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/styles.css", "headers": { "cache-control": "public, max-age=3600" }, "continue": true },
    { "src": "/main.js", "headers": { "cache-control": "public, max-age=3600" }, "continue": true },
    { "src": "/", "dest": "/index.php" }
  ]
}
